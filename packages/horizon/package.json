{
  "name": "@graphprotocol/horizon",
  "version": "1.1.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "Graph Horizon - Next generation Graph Protocol contracts",
  "author": "Edge & Node",
  "license": "GPL-2.0-or-later",
  "types": "typechain-types/index.ts",
  "exports": {
    "./artifacts/*": "./build/contracts/*",
    "./addresses*": "./addresses*",
    "./contracts/*": "./contracts/*",
    "./ignition": "./ignition/modules/index.ts",
    "./tasks/*": "./tasks/*",
    "./test/*": "./test/*"
  },
  "files": [
    "build/contracts/**/*",
    "typechain-types/**/*",
    "README.md"
  ],
  "dependenciesMeta": {
    "@graphprotocol/contracts": {
      "injected": true
    },
    "@graphprotocol/interfaces": {
      "injected": true
    }
  },
  "scripts": {
    "lint": "pnpm lint:ts; pnpm lint:sol; pnpm lint:forge; pnpm lint:md; pnpm lint:json",
    "lint:ts": "eslint --fix --cache '**/*.{js,ts,cjs,mjs,jsx,tsx}'; prettier -w --cache --log-level warn '**/*.{js,ts,cjs,mjs,jsx,tsx}'",
    "lint:sol": "solhint --fix --noPrompt --noPoster 'contracts/**/*.sol'; prettier -w --cache --log-level warn '**/*.sol'",
    "lint:forge": "forge lint contracts/",
    "lint:md": "markdownlint --fix --ignore-path ../../.gitignore '**/*.md'; prettier -w --cache --log-level warn '**/*.md'",
    "lint:json": "prettier -w --cache --log-level warn '**/*.json'",
    "clean": "rm -rf build dist cache cache_forge coverage typechain-types",
    "build": "pnpm build:dep && pnpm build:self",
    "build:dep": "pnpm --filter '@graphprotocol/horizon^...' run build:self",
    "build:self": "hardhat compile --quiet",
    "test": "pnpm build && pnpm test:self",
    "test:self": "hardhat test solidity",
    "test:deployment": "hardhat test test/deployment/*.ts",
    "test:integration": "./scripts/integration",
    "test:coverage": "pnpm build && pnpm test:coverage:self",
    "test:coverage:self": "hardhat test solidity --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@graphprotocol/contracts": "workspace:^",
    "@graphprotocol/interfaces": "workspace:^",
    "@graphprotocol/toolshed": "workspace:^",
    "@nomicfoundation/hardhat-ethers": "^4.0.14",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "catalog:",
    "@nomicfoundation/hardhat-mocha": "^3.0.21",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.0.21",
    "@nomicfoundation/ignition-core": "^3.1.8",
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "@openzeppelin/foundry-upgrades": "0.4.0",
    "@solidstate/hardhat-contract-sizer": "^3.0.3",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.0",
    "@types/node": ">=16.0.0",
    "chai": "^5.1.2",
    "eslint": "catalog:",
    "ethers": "catalog:",
    "forge-std": "catalog:",
    "glob": "^11.0.1",
    "hardhat": "^3.11.0",
    "hardhat-graph-protocol": "workspace:^",
    "lint-staged": "catalog:",
    "mocha": "^11.0.0",
    "prettier": "catalog:",
    "prettier-plugin-solidity": "catalog:",
    "solhint": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "contracts/**/*.sol": [
      "pnpm lint:sol"
    ],
    "**/*.ts": [
      "pnpm lint:ts"
    ],
    "**/*.js": [
      "pnpm lint:ts"
    ],
    "**/*.json": [
      "pnpm lint:ts"
    ]
  }
}
